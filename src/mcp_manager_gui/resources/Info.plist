<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Application Identification -->
    <key>CFBundleIdentifier</key>
    <string>com.mcp-manager.gui</string>
    
    <key>CFBundleName</key>
    <string>MCP Manager</string>
    
    <key>CFBundleDisplayName</key>
    <string>MCP Manager</string>
    
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    
    <!-- Application Type -->
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    
    <key>CFBundleExecutable</key>
    <string>mcp-manager-gui</string>
    
    <!-- Icons -->
    <key>CFBundleIconFile</key>
    <string>app_icon.icns</string>
    
    <key>CFBundleIconFiles</key>
    <array>
        <string>app_icon_16.png</string>
        <string>app_icon_32.png</string>
        <string>app_icon_64.png</string>
        <string>app_icon_128.png</string>
        <string>app_icon_256.png</string>
        <string>app_icon_512.png</string>
        <string>app_icon_1024.png</string>
    </array>
    
    <!-- System Requirements -->
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
    
    <key>LSRequiresNativeExecution</key>
    <true/>
    
    <!-- Application Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    
    <!-- UI Mode -->
    <key>LSUIElement</key>
    <false/>
    
    <key>LSBackgroundOnly</key>
    <false/>
    
    <!-- High Resolution Support -->
    <key>NSHighResolutionCapable</key>
    <true/>
    
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    
    <!-- Appearance -->
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>
    
    <!-- Document Types -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>MCP Configuration</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.json</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>json</string>
                <string>mcp</string>
            </array>
            <key>CFBundleTypeDescription</key>
            <string>MCP Server Configuration File</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>TOML Configuration</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.toml</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>toml</string>
            </array>
            <key>CFBundleTypeDescription</key>
            <string>TOML Configuration File</string>
        </dict>
    </array>
    
    <!-- URL Schemes -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>MCP Manager Protocol</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>mcp-manager</string>
            </array>
            <key>CFBundleURLIconFile</key>
            <string>protocol_icon</string>
        </dict>
    </array>
    
    <!-- Permissions -->
    <key>NSAppleEventsUsageDescription</key>
    <string>MCP Manager needs to communicate with Claude Code and other applications to manage MCP servers.</string>
    
    <key>NSNetworkVolumesUsageDescription</key>
    <string>MCP Manager may need to access network volumes for server installations and configurations.</string>
    
    <key>NSRemovableVolumesUsageDescription</key>
    <string>MCP Manager may need to access external drives for server installations and backups.</string>
    
    <!-- Application Transport Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSExceptionMinimumTLSVersion</key>
                <string>TLSv1.0</string>
            </dict>
            <key>127.0.0.1</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSExceptionMinimumTLSVersion</key>
                <string>TLSv1.0</string>
            </dict>
        </dict>
    </dict>
    
    <!-- Hardened Runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    
    <key>com.apple.security.network.client</key>
    <true/>
    
    <key>com.apple.security.network.server</key>
    <true/>
    
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    
    <!-- Developer Information -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2024 MCP Manager. All rights reserved.</string>
    
    <!-- Application Support -->
    <key>LSMultipleInstancesProhibited</key>
    <false/>
    
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    
    <key>NSSupportsSuddenTermination</key>
    <false/>
    
    <!-- Menu Bar -->
    <key>LSUIElement</key>
    <false/>
    
    <!-- Services -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Open with MCP Manager</string>
            </dict>
            <key>NSMessage</key>
            <string>openWithMCPManager</string>
            <key>NSPortName</key>
            <string>MCP Manager</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
            </array>
        </dict>
    </array>
    
    <!-- Spotlight Integration -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.mcp-manager.mcp-config</string>
            <key>UTTypeDescription</key>
            <string>MCP Configuration File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mcp</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/json</string>
                </array>
            </dict>
        </dict>
    </array>
    
    <!-- Quick Look -->
    <key>QLSupportedContentTypes</key>
    <array>
        <string>public.json</string>
        <string>public.toml</string>
        <string>com.mcp-manager.mcp-config</string>
    </array>
    
    <!-- App Store -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>claude</string>
        <string>docker</string>
        <string>http</string>
        <string>https</string>
    </array>
    
    <!-- Accessibility -->
    <key>NSAccessibilityUsageDescription</key>
    <string>MCP Manager uses accessibility features to integrate with other applications for enhanced workflow management.</string>
    
    <!-- System Integration -->
    <key>LSEnvironment</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    
    <!-- Privacy -->
    <key>NSCalendarsUsageDescription</key>
    <string>MCP Manager does not access calendar data.</string>
    
    <key>NSContactsUsageDescription</key>
    <string>MCP Manager does not access contact data.</string>
    
    <key>NSLocationUsageDescription</key>
    <string>MCP Manager does not access location data.</string>
    
    <key>NSMicrophoneUsageDescription</key>
    <string>MCP Manager does not access microphone.</string>
    
    <key>NSCameraUsageDescription</key>
    <string>MCP Manager does not access camera.</string>
    
