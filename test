#!/bin/bash
#
# Enhanced Test Launcher for MCP Manager - Pytest vs JSON Comparison
#
# Usage:
#   ./test                    # Interactive menu
#   ./test smoke             # Quick smoke test (JSON default)
#   ./test smoke --pytest   # Quick smoke test (legacy pytest)  
#   ./test smoke --compare   # Run both and compare results
#   ./test unit              # Unit tests
#   ./test all               # All tests
#   ./test files             # Show output files for sharing
#

# Function to run pytest tests
run_pytest() {
    echo "🧪 Running PYTEST Tests: $*"
    echo "=========================="
    python tests/test_runner.py "$@"
    return $?
}

# Function to run JSON tests
run_json() {
    echo "🤖 Running JSON Tests: $*"
    echo "======================="
    python tests/json_test_runner_cli.py "$@"
    return $?
}

# Function to compare both test systems
compare_tests() {
    local test_category="$1"
    
    echo "⚖️  COMPARING PYTEST vs JSON SYSTEMS"
    echo "======================================"
    echo "Category: $test_category"
    echo ""
    
    # Create temp files for results
    pytest_result=$(mktemp)
    json_result=$(mktemp)
    
    echo "📊 Running pytest tests..."
    if run_pytest "$test_category" > "$pytest_result" 2>&1; then
        pytest_exit=0
    else
        pytest_exit=$?
    fi
    
    echo "📊 Running JSON tests..."
    if run_json "$test_category" > "$json_result" 2>&1; then
        json_exit=0
    else
        json_exit=$?
    fi
    
    echo ""
    echo "🔍 COMPARISON RESULTS:"
    echo "====================="
    
    # Extract test counts
    pytest_count=$(grep -o "passed" "$pytest_result" | wc -l | tr -d ' ')
    pytest_failed=$(grep -o "failed" "$pytest_result" | wc -l | tr -d ' ')
    
    json_passed=$(grep "✅ Passed:" "$json_result" | sed 's/.*✅ Passed: \([0-9]*\).*/\1/')
    json_failed=$(grep "❌ Failed:" "$json_result" | sed 's/.*❌ Failed: \([0-9]*\).*/\1/')
    
    echo "📈 PYTEST Results:"
    echo "   Exit code: $pytest_exit"
    echo "   Passed: ${pytest_count:-0}"
    echo "   Failed: ${pytest_failed:-0}"
    
    echo ""
    echo "📈 JSON Results:"
    echo "   Exit code: $json_exit"
    echo "   Passed: ${json_passed:-0}"
    echo "   Failed: ${json_failed:-0}"
    
    echo ""
    if [ "$pytest_exit" -eq "$json_exit" ]; then
        echo "✅ Exit codes MATCH ($pytest_exit)"
    else
        echo "❌ Exit codes DIFFER (pytest: $pytest_exit, json: $json_exit)"
    fi
    
    if [ "$pytest_count" = "$json_passed" ] && [ "$pytest_failed" = "$json_failed" ]; then
        echo "✅ Test counts MATCH"
    else
        echo "❌ Test counts DIFFER"
    fi
    
    echo ""
    echo "📄 Detailed Results:"
    echo "===================="
    echo "📁 Pytest output saved to: $pytest_result"
    echo "📁 JSON output saved to: $json_result"
    echo ""
    echo "To see full results:"
    echo "  cat $pytest_result"
    echo "  cat $json_result"
    
    # Cleanup on success, keep files on differences for debugging
    if [ "$pytest_exit" -eq "$json_exit" ] && [ "$pytest_count" = "$json_passed" ]; then
        rm -f "$pytest_result" "$json_result"
        echo "✅ Results match - temporary files cleaned up"
        return 0
    else
        echo "⚠️  Results differ - keeping temp files for analysis"
        return 1
    fi
}

# Parse arguments
test_type=""
use_json=false
use_pytest=false
compare_mode=false

for arg in "$@"; do
    case $arg in
        --json)
            use_json=true
            shift
            ;;
        --pytest|--legacy)
            use_pytest=true
            shift
            ;;
        --compare)
            compare_mode=true
            shift
            ;;
        --help)
            echo "MCP Manager Test System - Pytest vs JSON Comparison"
            echo ""
            echo "Usage:"
            echo "  ./test                     # Interactive menu (JSON default)"
            echo "  ./test smoke              # JSON smoke tests (default)"  
            echo "  ./test smoke --json       # Force JSON mode"
            echo "  ./test smoke --pytest     # Force legacy pytest mode"
            echo "  ./test smoke --compare    # Compare JSON vs Pytest"
            echo "  ./test server --compare   # Compare server tests"
            echo "  ./test all --compare      # Compare all tests"
            echo ""
            echo "Available test categories:"
            echo "  smoke, unit, server, suite, quality, error, workflow, all"
            echo ""
            echo "Special commands:"
            echo "  files                      # Show test output files"
            echo "  nuke                       # Nuclear config reset (removes all)"
            echo ""
            echo "Testing Systems:"
            echo "  JSON Engine: Default modern system (recommended)"
            echo "  Legacy Pytest: Backward compatibility mode"
            echo ""
            echo "Comparison shows:"
            echo "  - Exit codes (should match)"
            echo "  - Pass/fail counts (should match)"
            echo "  - Execution differences"
            exit 0
            ;;
        files)
            echo "📁 Showing MCP Manager Test Output Files..."
            python tests/tools/show_test_files.py
            exit $?
            ;;
        nuke)
            echo "💥 Launching Nuclear Config Reset..."
            python -c "
import sys
sys.path.append('tests/tools')
from test_menu import TestMenu
menu = TestMenu()
menu.nuke_config()
"
            exit $?
            ;;
        *)
            test_type="$arg"
            ;;
    esac
done

# If no arguments, launch interactive menu
if [ $# -eq 0 ]; then
    echo "🧪 Launching MCP Manager Interactive Test Menu..."
    echo ""
    echo "Quick options:"
    echo "  ./test smoke --compare    # Compare smoke tests"
    echo "  ./test server --compare   # Compare server tests"  
    echo "  ./test smoke --json       # JSON engine (default)"
    echo "  ./test --help            # Show all options"
    echo ""
    echo "💡 Default: JSON Test Engine (modern), Legacy: Pytest (compatibility)"
    python tests/tools/test_menu.py
    exit $?
fi

# Execute based on mode
if [ "$compare_mode" = true ]; then
    compare_tests "$test_type"
elif [ "$use_json" = true ]; then
    run_json "$test_type"
elif [ "$use_pytest" = true ]; then
    echo "🔄 Using Legacy Pytest Mode (backward compatibility)"
    run_pytest "$test_type"
else
    # Default to JSON system (modern approach)
    if [ -z "$test_type" ]; then
        echo "❌ No test type specified"
        exit 1
    fi
    
    echo "💡 Using JSON Test Engine (default). Use --pytest for legacy mode."
    run_json "$test_type"
fi