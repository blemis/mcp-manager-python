    "name": "Basic Commands Smoke Test",
    "description": "Critical smoke test validating core CLI functionality that every user would try first. Tests application startup, help system, and basic command availability.",
    "created_by": "migration",
    "category": "smoke",
    "confidence_score": 0.98,
