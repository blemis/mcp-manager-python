  "test_steps": [
    {
      "step_id": 1,
      "action": "cli_command",
      "command": "--help",
      "expect": "success",
      "timeout": 10,
      "setup_required": false,
      "cleanup_on_failure": false,
      "retry_count": 0,
      "description": "Verify application starts and responds to help command"
    },
    {
      "step_id": 2,
      "action": "validation",
      "parameters": {
        "validate_type": "help_output",
        "required_sections": ["Usage:", "Commands:", "Options:"]
      },
      "expect": "contains",
      "expect_value": "Usage:",
      "timeout": 5,
      "description": "Validate help output contains required sections"
    },
    {
      "step_id": 3,
      "action": "validation",
      "parameters": {
        "validate_type": "core_commands_present",
        "required_commands": ["add", "remove", "list", "discover", "suite", "quality", "install", "status", "system-info"]
      },
      "expect": "contains",
      "expect_value": "list",
      "timeout": 5,
      "description": "Verify all core commands are available in help"
    },
    {
      "step_id": 4,
      "action": "cli_command",
      "command": "nonexistent-command",
      "expect": "failure",
      "timeout": 10,
      "description": "Test error handling with invalid command"
    },
    {
      "step_id": 5,
      "action": "cli_command",
      "command": "list",
      "expect": "success",
      "timeout": 15,
      "description": "Test baseline list command functionality"
    }
  ],
  "validation": {
    "success_criteria": [
