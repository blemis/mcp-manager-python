#!/bin/bash
#
# JSON Test Runner for MCP Manager - Modern AI-Powered Testing
#
# Usage:
#   ./test-json                          # Interactive menu
#   ./test-json smoke                   # Quick smoke test
#   ./test-json core                    # Core functionality tests
#   ./test-json --list                  # List available scenarios
#   ./test-json --generate "description" # Generate AI scenario
#   ./test-json --priority high         # Run high priority tests
#

# Check if Python can import the JSON test system
if ! python -c "import sys; sys.path.append('.'); from tests.engine.json_test_runner import JsonTestRunner" 2>/dev/null; then
    echo "❌ JSON test system not available. Run './test' for traditional pytest system."
    exit 1
fi

# If no arguments, show usage and available options
if [ $# -eq 0 ]; then
    echo "🧪 MCP Manager JSON Test System"
    echo "==============================="
    echo ""
    echo "Available Commands:"
    echo "  ./test-json smoke              # Run smoke tests (fastest)"
    echo "  ./test-json core               # Run core functionality tests"
    echo "  ./test-json all                # Run all available tests"
    echo "  ./test-json --list             # List available test scenarios"
    echo ""
    echo "AI-Powered Features:"
    echo "  ./test-json --generate 'Test filesystem with permissions'"
    echo "  ./test-json --priority critical"
    echo ""
    echo "Advanced Options:"
    echo "  ./test-json core --batch-size 3 --stop-on-failure"
    echo "  ./test-json --created-by ai"
    echo ""
    echo "📊 Current Status:"
    
    # Show quick stats
    python -c "
import sys
sys.path.append('.')
from tests.engine.json_test_runner import JsonTestRunner
runner = JsonTestRunner()
scenarios = runner.discover_scenarios()
migrated = len([s for s in scenarios if s.created_by == 'migration'])
ai_gen = len([s for s in scenarios if s.created_by == 'ai'])
print(f'   • Total scenarios: {len(scenarios)}')
print(f'   • Migrated from pytest: {migrated}')
print(f'   • AI generated: {ai_gen}')
" 2>/dev/null || echo "   • Status unavailable"
    
    echo ""
    echo "For traditional pytest system, use: ./test"
    exit 0
fi

# Execute the JSON test runner
echo "🚀 Running MCP Manager JSON Tests..."
python tests/json_test_runner_cli.py "$@"